#!/bin/bash
# Runs once on the first boot (cloud-init). Installs the runtime, no game version.
# OpenTofu template: placeholders are filled in by templatefile(), a doubled dollar sign stays a literal dollar.
set -euxo pipefail

dnf install -y java-25-amazon-corretto-headless nginx

# ttyd is not in the Amazon Linux repos: fixed version, checked against a known checksum
curl -fsSL -o /usr/local/bin/ttyd \
  "https://github.com/tsl0922/ttyd/releases/download/${ttyd_version}/ttyd.x86_64"
echo "${ttyd_sha256}  /usr/local/bin/ttyd" | sha256sum -c -
chmod 755 /usr/local/bin/ttyd

# The game never runs as root
useradd --system --home-dir /opt/tictactest --shell /sbin/nologin tictactest
install -d -o tictactest -g tictactest -m 755 /opt/tictactest

# Downloads the JAR of $VERSION once (with checksum) and publishes the version for nginx
cat > /usr/local/bin/tictactest-fetch <<'EOF'
#!/bin/sh
set -eu
cd /opt/tictactest
jar="tictactoe-$VERSION.jar"
if [ ! -f "$jar" ]; then
  base="https://github.com/${github_repo}/releases/download/v$VERSION"
  curl -fsSLO "$base/$jar"
  curl -fsSLO "$base/$jar.sha256"
  sha256sum -c "$jar.sha256" || { rm -f "$jar" "$jar.sha256"; exit 1; }
fi
echo "$VERSION" > version.txt
EOF
chmod 755 /usr/local/bin/tictactest-fetch

# VERSION comes from /etc/tictactest.env, written by the deployment, kept on disk across reboots
cat > /etc/systemd/system/tictactest.service <<'EOF'
[Unit]
Description=TicTacTest web console (ttyd + release JAR)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/tictactest.env

[Service]
User=tictactest
EnvironmentFile=/etc/tictactest.env
ExecStartPre=/usr/local/bin/tictactest-fetch
ExecStart=/usr/local/bin/ttyd --writable --interface lo --port 7681 --max-clients 10 java -Xmx32m -XX:+UseSerialGC -jar /opt/tictactest/tictactoe-$${VERSION}.jar
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

# nginx is the only public entry: proxies the console (WebSocket) and serves the version
cat > /etc/nginx/conf.d/tictactest.conf <<'EOF'
server {
    listen 80;

    location = /version {
        alias /opt/tictactest/version.txt;
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        add_header Access-Control-Allow-Origin "${frontend_origin}" always;
    }

    location / {
        proxy_pass http://127.0.0.1:7681;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
    }
}
EOF

systemctl daemon-reload
systemctl enable --now nginx
# Starts as soon as the first deployment has written /etc/tictactest.env
systemctl enable tictactest
